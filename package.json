{
  "name": "lumenote",
  "version": "0.1.0",
  "private": true,
  "description": "Lumenote — 可追溯的 AI 文本工作台",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "test:coverage": "node scripts/test.mjs --coverage",
    "test:integration": "node scripts/test.mjs --config vitest.integration.config.ts",
    "test:redis": "node scripts/verify/rate-limit-redis.mjs",
    "smoke": "node scripts/smoke.mjs",
    "eval:report": "tsx scripts/eval/report.ts",
    "github:status": "node scripts/github/harden-repo.mjs status",
    "github:protect": "node scripts/github/harden-repo.mjs protect",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:all": "pnpm prisma validate && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.62.7",
    "ai": "^7.0.143",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.469.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.6.0",
    "undici": "^8.12.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.5",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver"
    ]
  }
}