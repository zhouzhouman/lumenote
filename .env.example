# ============================================================
# Lumenote 环境变量样例
# 复制为 .env.local 后填入真实值。.env.local 已被 .gitignore 忽略。
# ⚠️ 切勿把真实 API Key 或数据库连接串提交到仓库。
# ============================================================

# ---------- 数据库 ----------
# 本地开发：可用 docker-compose up -d（默认 postgres://lumenote:lumenote@localhost:5432/lumenote）
# 云端：Neon / Supabase 的连接串
DATABASE_URL="postgresql://lumenote:lumenote@localhost:5432/lumenote?schema=public"
# 迁移直连地址（绕过连接池），生产环境建议单独配置
DIRECT_URL="postgresql://lumenote:lumenote@localhost:5432/lumenote?schema=public"

# ---------- 鉴权 ----------
# 生成：openssl rand -base64 32
AUTH_SECRET="请替换为随机32字节密钥"
# access token 有效期（分钟）
JWT_ACCESS_TTL_MINUTES="15"
# refresh token 有效期（天）
JWT_REFRESH_TTL_DAYS="7"

# ---------- LLM Provider：DeepSeek（主） ----------
# base_url 用 OpenAI 兼容格式；strict JSON Schema 需用 https://api.deepseek.com/beta（本项目默认不用）
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY=""
# 默认模型：deepseek-flash（V4.1-Flash，低成本）/ deepseek-v4-pro（更强、更贵）
# 核对日期 2026-10-11，详见 docs/adr/0003-deepseek-capability-constraints.md
DEFAULT_MODEL="deepseek-flash"
# 主 Provider 不可用时的备用模型（同厂商内降级，避免跨厂商语义差异）
FALLBACK_MODEL="deepseek-v4-pro"

# ---------- LLM Provider：OpenAI（备用，跨厂商降级，可留空） ----------
OPENAI_API_KEY=""

# ---------- Mock 模式 ----------
# true 时不发起真实 LLM 请求，用本地模拟流式输出。预览环境建议强制开启以免烧钱。
# 不配置时：预览环境（VERCEL_ENV !== production）自动启用 mock
MOCK_LLM="true"

# ---------- 限流 ----------
# 每用户每日任务配额（次）。仅对使用站点凭证的用户生效；
# 配置了自己的 API Key 的用户不占用站点配额（费用由他自己承担）
FREE_DAILY_QUOTA="20"
# 单 IP 每分钟请求上限
RATE_LIMIT_PER_MINUTE="10"
# 单用户同时进行中的任务上限（成本保护，防并发烧钱）
# 注意：BYOK 用户同样受此限制 —— 它保护的是用户自己的钱包
MAX_CONCURRENT_TASKS_PER_USER="1"

# ---------- 限流后端（memory | redis） ----------
# memory（默认）：进程内存计数。单实例/本地开发够用；实例重启即清零，
#                 多实例之间不共享（每个实例各算各的 = 实际限额被放大 N 倍）。
# redis         ：多实例共享计数，需要下面的 REDIS_URL 可达。
#                 本地启用：docker compose up -d redis（compose 已包含 redis 服务）
RATE_LIMIT_DRIVER="memory"
# Redis 连接串（仅 RATE_LIMIT_DRIVER=redis 时使用）
REDIS_URL="redis://127.0.0.1:6379"
# Redis 计数 key 前缀。生产/预发/本地共用一个 Redis 时必须区分，否则计数互相污染
RATE_LIMIT_REDIS_PREFIX="lumenote:rl:"
# Redis 故障时的降级策略：
#   open（默认）—— 回退到进程内存限流并记录 warn。可用性优先；
#                  代价：故障期间限流退化为「每实例」，弱于全局但强于完全放行。
#   closed      —— 直接拒绝请求（调用方返回 429）。安全优先，Redis 故障时全站拒绝。
# ⚠️ 两种模式都不会把异常抛给业务层；closed 是有意的严格模式，不是故障。
RATE_LIMIT_FAIL_MODE="open"
# 可信反向代理层数（X-Forwarded-For 信任边界）：
#   0（默认）—— 不信任任何转发头。XFF / x-real-ip 一律忽略，客户端 IP 记为 unknown，
#              所有请求共享一个限流桶：无法伪造绕过，但也无法区分客户端。
#   N > 0   —— 从 XFF 右侧往左数第 N 个地址作为客户端 IP（客户端在最左，代理逐跳追加）。
#              XFF 左侧伪造的前缀不影响取值；段数少于 N 时视为不可信，回退 unknown。
#              nginx 单层代理通常设 1；Cloudflare + nginx 两层设 2。
# ⚠️ 设 N > 0 的前提是应用端口只对可信代理开放；否则直连者可以自己写 XFF 绕过限流。
# ⚠️ 这是「限流用的 IP」，不是身份认证依据；x-real-ip 同样可伪造，只在信任链内使用。
TRUST_PROXY_HOPS="0"
# Redis 真实连通性与原子性验证（本机无 Redis 时会打印 SKIPPED 并以退出码 2 结束）：
#   docker compose up -d redis && pnpm test:redis

# ---------- 用户自带 API Key（BYOK） ----------
# 是否允许用户在工作台「模型设置」里配置自己的模型 Key。
# false 时 /api/credentials 直接返回 403，界面上也看不到入口。
# 密钥用 AUTH_SECRET 派生出的密钥做 AES-256-GCM 加密后入库，永不回传前端。
# ⚠️ 更换 AUTH_SECRET 会导致已保存的密钥全部无法解密（用户需重新填写）。
ALLOW_USER_CREDENTIALS="true"
# 允许用户在自定义接口地址里填写公网 https 地址（用于中转网关/自建端点）。
# 设为 false 则只允许内置服务商的官方地址，内网与元数据地址始终被拦截。
ALLOW_CUSTOM_BASE_URL="true"

# ---------- 输入与抓取限制 ----------
# 单次提交文本最大字符数
MAX_INPUT_CHARS="100000"
# URL 抓取超时（毫秒）
FETCH_TIMEOUT_MS="15000"
# URL 抓取响应体最大字节数
FETCH_MAX_BYTES="5000000"
# URL 抓取主机白名单，逗号分隔；留空表示不限制（生产建议配置）
FETCH_ALLOWED_HOSTS=""

# ---------- 管线参数 ----------
# Map-Reduce 分块大小（token 估算值）
CHUNK_SIZE_TOKENS="1200"
# 分块重叠（token 估算值），防止跨块信息丢失
CHUNK_OVERLAP_TOKENS="100"
# Map 阶段并发上限
CHUNK_CONCURRENCY="3"

# ---------- 邮件（注册验证码） ----------
# 通道：console | resend | smtp
#   console —— 不发信，验证码打到服务端日志，并在**非生产环境**回传到注册页自动填入。
#              本地开发用这个，零配置。生产环境必须换 resend/smtp，
#              因为代码会硬性拒绝在生产环境回传验证码（否则验证环节形同虚设）。
#   resend  —— 调 Resend HTTP API，只需下面的 RESEND_API_KEY（免费额度 100 封/天）
#   smtp    —— 尚未接入（会返回明确错误而不是静默失败），需要自行安装 nodemailer
MAIL_TRANSPORT="console"
# 发件人显示名与地址。用 resend 时必须是已在 Resend 验证过的域名
MAIL_FROM="Lumenote <no-reply@lumenote.local>"
RESEND_API_KEY=""

# ---------- 登录安全 ----------
# 连续失败多少次后锁定登录（0 = 关闭锁定，仅保留限流）
LOGIN_MAX_FAILURES="5"
# 锁定窗口（分钟）。窗口内失败次数超阈值即锁定
LOGIN_LOCKOUT_MINUTES="15"

# ---------- 应用 ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"